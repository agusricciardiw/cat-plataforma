# Copiar a /opt/sigat/.env en el VPS y completar los valores reales

# Base de datos
DB_NAME=sigat_prod
DB_USER=sigat
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
# Poner true solo si la DB requiere TLS (Supabase, RDS, Neon, etc.)
# El postgres del docker-compose interno no usa SSL → dejar en false
DB_SSL=false

# JWT
JWT_SECRET=CAMBIAR_SECRET_LARGO_Y_RANDOM
JWT_EXPIRES_IN=8h

# URL pública del frontend (usada por CORS del backend)
# Ejemplo: http://sigat.buenosaires.gob.ar  o  http://[2800:6c0:5::216f]
FRONTEND_URL=http://TU_DOMINIO_O_IP

# La URL que el frontend usa para llamar al backend.
# Dejar vacío si nginx hace el proxy en el mismo dominio (recomendado).
# Si el backend está en otro dominio: VITE_API_URL=https://api.sigat.gob.ar
VITE_API_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=TU_API_KEY

# SMTP (notificaciones por email)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=cat-notificaciones@buenosaires.gob.ar
SMTP_PASS=CAMBIAR_PASSWORD_SMTP
